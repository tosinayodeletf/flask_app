pipeline {
  agent {
  label 'Linux'
}


  environment {
    VENV = "${WORKSPACE}/venv"
  }

  stages {

    stage('Checkout Code') {
      steps {
        git branch: 'main', url: 'https://github.com/tosinayodeletf/flask_app.git'
      }
    }

    stage('Setup Python Environment') {
      steps {
        sh '''
        sudo dnf install -y python3.11 python3.11-venv

        python3.11 -m venv ${VENV}
        . ${VENV}/bin/activate
        pip install --upgrade pip
        '''
      }
    }

    stage('Install Dependencies') {
      steps {
        sh '''
        . ${VENV}/bin/activate
        pip install -r requirements.txt
        '''
      }
    }

    stage('Run Tests') {
      steps {
        sh '''
        . ${VENV}/bin/activate
        echo "NO TESTS DEFINED - SKIPPING"
        '''
      }
    }

    stage('Run Flask Application') {
      steps {
        sh '''
        . ${VENV}/bin/activate
        echo "Starting Flask app in background..."
        nohup python app.py > flask.log 2>&1 &
        '''
      }
    }
  }

  post {
    success {
      echo 'FLASK CI/CD pipeline executed SUCCESSFULLY'
    }
    failure {
      echo 'PIPELINE FAILED!!! CHECK LOGS'
    }
  }
}
